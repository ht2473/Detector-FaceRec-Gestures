# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
.Python

# ── Virtual environments ──────────────────────────────────────────────────────
venv/
.venv/
env/
ENV/

# ── Distribution / packaging ──────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
wheels/

# ── ML models (large binaries — download separately) ──────────────────────────
models/*.pt
models/*.onnx
models/*.engine
models/*.tflite
!models/.gitkeep

# ── MediaPipe task file (large binary) ────────────────────────────────────────
hand_landmarker.task

# ── Application output ────────────────────────────────────────────────────────
output/*
!output/.gitkeep

# ── Logs ──────────────────────────────────────────────────────────────────────
logs/*
!logs/.gitkeep

# ── Face database (personal data) ─────────────────────────────────────────────
FaceDB/*
!FaceDB/.gitkeep

# ── IDE / editors ─────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ── pytest / coverage ─────────────────────────────────────────────────────────
.pytest_cache/
.coverage
htmlcov/

# ── mypy ──────────────────────────────────────────────────────────────────────
.mypy_cache/
