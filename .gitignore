# --- Окружение и зависимости ---
# Игнорируем виртуальное окружение, чтобы не загружать гигабайты библиотек
venv/
.env
__pycache__/
*.py[cod]
*$py.class

# --- Сборка и дистрибуция ---
# Игнорируем папки, которые создает PyInstaller
build/
dist/
*.spec

# --- Специфично для проекта ---
# Логи работы программы
logs/
*.log

# Тяжелые модели нейросетей (они должны скачиваться отдельно или быть в релизе)
models/*.onnx
models/*.pt
models/*.weights
models/*.pth
*.task

# База данных лиц (содержит персональные данные)
Face DB/

# Результаты работы (видео, скриншоты, JSON отчеты)
output/
*.mp4
*.avi
*.jpg
*.png
*.json

# --- Системные файлы и IDE ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

